# fire-intel backend settings. Copy to .env and fill in. Never commit .env.

# Supabase Session pooler (port 5432) or a local Postgres.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Required, at least 24 characters.
API_AUTH_TOKEN=
BIND_ADDR=0.0.0.0:8080

# Text inference stays self-hosted (AI_PROVIDER must remain "vllm").
VLLM_BASE_URL=http://100.124.134.63:8890
VLLM_MODEL=qwen3.8-flash-next
VLLM_API_KEY=

# Vision for POST /ai/scan. Defaults to the VLLM_* server above (that model
# accepts images). Set these three to route scans to a different vision
# server; keys come from env only.
#VISION_BASE_URL=
#VISION_MODEL=
#VISION_API_KEY=

# Scan requests per token per minute.
SCAN_RATE_LIMIT_PER_MINUTE=20
